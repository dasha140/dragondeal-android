<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".DragonDealApp"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Marketgm">
        <activity
            android:name=".screens.AddListingActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <activity android:name=".screens.OrdersActivity"
            android:exported="false"/>

        <activity android:name=".screens.OrderDetailActivity"
            android:exported="false"/>

        <activity android:name=".screens.MyListingsActivity"
            android:exported="false"/>

        <activity
            android:name=".screens.SettingsActivity"
            android:exported="false" />

        <activity android:name=".screens.VerifyEmailActivity"
            android:exported="false"/>

        <activity
            android:name=".screens.SignupActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <activity
            android:name=".screens.MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>
        <activity android:name=".screens.ChatActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false"/>

        <activity
            android:name=".screens.PaymentActivity"
            android:exported="false" />

        <activity
            android:name=".screens.ListingDetailActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <activity
            android:name=".screens.SigninActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <activity
            android:name=".screens.SupportActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <activity
            android:name=".screens.AboutActivity"
            android:exported="false" />

        <activity
            android:name=".screens.SellerProfileActivity"
            android:exported="false" />

        <activity
            android:name=".screens.SellerReviewsActivity"
            android:exported="false" />
    </application>

</manifest>
