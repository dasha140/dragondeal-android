<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="20dp"
            android:paddingEnd="14dp"
            android:paddingBottom="16dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/buttonAboutBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="#FFFFFF"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="О приложении"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- App Name & Version Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card_dark"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="24dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DragonDeal"
                    android:textColor="#FF3B30"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Версия 1.0.0"
                    android:textColor="#9A9AA0"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Description -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Описание"
                    android:textColor="#FF3B30"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="3dp"
                    android:text="DragonDeal — это учебный P2P-маркетплейс игровых товаров и услуг. Пользователи могут создавать объявления, просматривать предложения, оформлять заказы, обращаться в поддержку и использовать встроенную логику безопасной сделки."
                    android:textColor="#EAF2F5"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="#1A2A30"
                    android:lineSpacingExtra="3dp"
                    android:padding="12dp"
                    android:text="Важно: Приложение создано как учебный проект. Часть функций может работать в тестовом режиме. Escrow smart contract и blockchain-часть используются локально для демонстрации и не являются реальной финансовой инфраструктурой."
                    android:textColor="#FFB74D"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Features -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Основные возможности"
                    android:textColor="#FF3B30"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="4dp"
                    android:text="• регистрация и вход в аккаунт;\n• просмотр игровых объявлений;\n• создание собственных объявлений;\n• оформление заказов;\n• чат между покупателем и продавцом по заказу;\n• профиль пользователя;\n• история сделок;\n• обращения в поддержку;\n• базовая логика безопасной сделки."
                    android:textColor="#EAF2F5"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Rules -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Правила использования"
                    android:textColor="#FF3B30"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="4dp"
                    android:text="1. Не размещайте мошеннические, вредоносные или вводящие в заблуждение объявления.\n2. Не публикуйте чужие персональные данные.\n3. Не используйте приложение для продажи запрещённых товаров или услуг.\n4. Не пытайтесь обходить ограничения системы, авторизацию или проверки безопасности.\n5. Пользователь несёт ответственность за достоверность информации в своих объявлениях.\n6. Администрация может ограничить доступ к функциям приложения при нарушении правил."
                    android:textColor="#EAF2F5"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Safe Deal -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Безопасная сделка"
                    android:textColor="#FF3B30"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Механизм безопасной сделки в проекте предназначен для демонстрации логики удержания оплаты до завершения заказа. В текущей версии blockchain/escrow contract запускается локально и используется только как демонстрационный компонент проекта."
                    android:textColor="#EAF2F5"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Support -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Поддержка"
                    android:textColor="#FF3B30"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Если у пользователя возникла проблема с заказом, аккаунтом или объявлением, он может создать обращение через раздел «Поддержка» в профиле. Ответ администратора отображается в истории обращений."
                    android:textColor="#EAF2F5"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Data Policy -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Политика данных"
                    android:textColor="#FF3B30"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Приложение может хранить данные аккаунта, объявления, заказы, сообщения поддержки и техническую информацию, необходимую для работы сервиса. Данные используются только для функционирования приложения и демонстрации возможностей проекта."
                    android:textColor="#EAF2F5"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Liability -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ограничение ответственности"
                    android:textColor="#FF3B30"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="3dp"
                    android:text="DragonDeal является учебным проектом и не является реальным коммерческим сервисом. Разработчик не несёт ответственности за использование приложения вне демонстрационных и образовательных целей."
                    android:textColor="#EAF2F5"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Contacts -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Контакты"
                    android:textColor="#FF3B30"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="3dp"
                    android:text="По вопросам работы приложения используйте раздел «Поддержка»."
                    android:textColor="#EAF2F5"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Technical Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Техническая информация"
                    android:textColor="#FF3B30"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="4dp"
                    android:text="Backend: Spring Boot\nMobile: Android Java\nDatabase: H2/PostgreSQL\nBlockchain demo: Hardhat local network\nAPI mode: local/debug and production-ready backend URL via BuildConfig"
                    android:textColor="#EAF2F5"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>
