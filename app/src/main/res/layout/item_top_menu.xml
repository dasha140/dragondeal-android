<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chipRoot"
    android:layout_width="wrap_content"
    android:layout_height="36dp"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="4dp"
    android:layout_gravity="center_vertical"
    android:background="@drawable/bg_chip_category_unselected"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <ImageView
        android:id="@+id/imageMenuIcon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_category_grid" />

    <TextView
        android:id="@+id/textMenuTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="Аккаунты"
        android:textColor="#EAF2F5"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
