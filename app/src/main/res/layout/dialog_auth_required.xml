<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_auth_required_dialog"
    android:paddingStart="24dp"
    android:paddingTop="28dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/textAuthRequiredTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Нужна авторизация"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/textAuthRequiredMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text=""
        android:textColor="#9E9E9E"
        android:textSize="15sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3" />

    <TextView
        android:id="@+id/buttonAuthLogin"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_dragon_red_button"
        android:gravity="center"
        android:text="Войти"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/buttonAuthSignup"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_auth_red_outline_button"
        android:gravity="center"
        android:text="Зарегистрироваться"
        android:textColor="#FF3B30"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/buttonAuthCancel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Отмена"
        android:textColor="#8E8E93"
        android:textSize="16sp" />

</LinearLayout>
