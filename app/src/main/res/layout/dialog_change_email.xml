<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="14dp"
    android:paddingEnd="20dp"
    android:paddingBottom="22dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#3A3A3A" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Смена почты"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Введите новую почту, получите код и подтвердите изменение."
        android:textColor="#8E8E93"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Новая почта"
        android:textColor="#9A9AA0"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/editNewEmail"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_dark"
        android:hint="new@email.com"
        android:inputType="textEmailAddress"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#737373"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Текущий пароль"
        android:textColor="#9A9AA0"
        android:textSize="13sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_dark">

        <EditText
            android:id="@+id/editCurrentPassword"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:hint="Введите пароль"
            android:inputType="textPassword"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="44dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#737373"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/btnToggleChangeEmailPassword"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="@null"
            android:contentDescription="Показать пароль"
            android:padding="10dp"
            android:src="@drawable/ic_eye_off" />

    </FrameLayout>

    <TextView
        android:id="@+id/buttonSendEmailCode"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_dragon_red_outline_button"
        android:gravity="center"
        android:text="Отправить код"
        android:textColor="#FF3B30"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Код подтверждения"
        android:textColor="#9A9AA0"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/editEmailCode"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_dark"
        android:hint="000000"
        android:inputType="number"
        android:maxLength="6"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#737373"
        android:textSize="15sp" />

    <ProgressBar
        android:id="@+id/progressChangeEmail"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:indeterminateTint="#FF3B30"
        android:visibility="gone" />

    <TextView
        android:id="@+id/buttonConfirmEmailChange"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_dragon_red_button"
        android:gravity="center"
        android:text="Подтвердить"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/buttonCancelEmailChange"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Отмена"
        android:textColor="#8E8E93"
        android:textSize="15sp" />

</LinearLayout>
