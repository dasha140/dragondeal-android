<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="#3A3A3A" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Смена пароля"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Получите код на почту и задайте новый пароль."
            android:textColor="#8E8E93"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Email"
            android:textColor="#9A9AA0"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/editResetEmail"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_dark"
            android:hint="example@gmail.com"
            android:inputType="textEmailAddress"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#737373"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/buttonSendPasswordResetCode"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_dragon_red_outline_button"
            android:gravity="center"
            android:text="Отправить код"
            android:textColor="#FF3B30"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Код подтверждения"
            android:textColor="#9A9AA0"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/editResetCode"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_dark"
            android:hint="000000"
            android:inputType="number"
            android:maxLength="6"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#737373"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Новый пароль"
            android:textColor="#9A9AA0"
            android:textSize="13sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_dark">

            <EditText
                android:id="@+id/editResetNewPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="Минимум 8 символов"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="44dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#737373"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/btnToggleResetPassword"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:background="@null"
                android:contentDescription="Показать пароль"
                android:padding="10dp"
                android:src="@drawable/ic_eye_off" />

        </FrameLayout>

        <ProgressBar
            android:id="@+id/progressPasswordReset"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:indeterminateTint="#FF3B30"
            android:visibility="gone" />

        <TextView
            android:id="@+id/buttonConfirmPasswordReset"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_dragon_red_button"
            android:gravity="center"
            android:text="Сменить пароль"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/buttonCancelPasswordReset"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Отмена"
            android:textColor="#8E8E93"
            android:textSize="15sp" />

    </LinearLayout>

</ScrollView>
