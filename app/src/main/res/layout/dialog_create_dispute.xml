<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="14dp"
        android:paddingEnd="22dp"
        android:paddingBottom="28dp">

        <View
            android:layout_width="42dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="#3A3A3A" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Открыть спор"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Опишите проблему с заказом. Администратор сможет рассмотреть спор."
            android:textColor="#8E8E93"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/editDisputeReason"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_add_listing_field_clear"
            android:gravity="top"
            android:hint="Например: продавец не передал товар"
            android:inputType="textMultiLine"
            android:maxLength="1000"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#737373"
            android:textSize="16sp" />

        <ProgressBar
            android:id="@+id/progressCreateDispute"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:indeterminateTint="#FF3B30"
            android:visibility="gone" />

        <TextView
            android:id="@+id/buttonConfirmCreateDispute"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_dragon_red_button"
            android:gravity="center"
            android:text="Открыть спор"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/buttonCancelCreateDispute"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Отмена"
            android:textColor="#8E8E93"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>